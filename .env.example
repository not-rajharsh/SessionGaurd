# Copy to .env (or just run `npm run demo`, which generates one with random secrets).
# Blank secrets are refused at startup; nothing is hardcoded in source.

# Demo account (the single hardcoded user lives here, not in code)
DEMO_USER=demo
DEMO_PASSWORD=

# Secrets shared by the app / engine
SESSION_SECRET=
ENGINE_API_KEY=

# Ports and endpoints
APP_PORT=3000
ENGINE_PORT=8000
REDIS_URL=redis://127.0.0.1:6379/0
RISK_ENGINE_URL=http://127.0.0.1:8000

# Demo-only knobs. In production: TRUST_PROXY=<number of proxy hops> and
# EXPOSE_SIGNALS=false (never tell an attacker which signals fired).
TRUST_PROXY=true
EXPOSE_SIGNALS=true
